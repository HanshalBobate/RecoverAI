# ==============================================================================
# RecoverAI — Environment Configuration (Phase 3: LLM Brain)
# ==============================================================================

# Database Configuration (Defaults to local SQLite file in ./data)
DATABASE_PATH=./data/recoverai.db

# Application Environment
NODE_ENV=development
PORT=3000

# ==============================================================================
# LLM BRAIN & PROVIDER ABSTRACTION (PHASE 3)
# ==============================================================================
# Supported Providers: 'mock' | 'ollama' | 'openai' | 'gemini'
# DEFAULT: 'mock' (100% offline, deterministic, zero external API keys needed)
LLM_PROVIDER=mock

# 1. Ollama Configuration (Local Offline LLM)
# Ensure Ollama server is running (e.g. `ollama serve` and `ollama pull llama3.2`)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# 2. OpenAI Configuration (Cloud LLM)
# API key is evaluated server-side ONLY. Never committed to git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 3. Google Gemini Configuration (Cloud LLM)
# API key is evaluated server-side ONLY. Never committed to git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ==============================================================================
# SECURITY NOTICE:
# - .env is ignored in git and must never be committed.
# - API keys must never be exposed in client code or API JSON responses.
# - Phase 3 performs analysis and decision generation ONLY. Zero payment execution.
# ==============================================================================
